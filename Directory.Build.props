<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <PlatformToolset>v145</PlatformToolset>
    <StaticRuntime Condition="'$(StaticRuntime)' == ''">false</StaticRuntime>
    <!-- Issue #118 / docs/adr-phase-6.md ADR-0032: the single source of truth
         src/syncwingetlink.rc's VS_VERSION_INFO resource and src/cli/Version.h's
         kVersion both derive from (via the SYNCWINGETLINK_VER_MAJOR/MINOR/PATCH
         preprocessor definitions below). src/app.manifest's assemblyIdentity version
         stays hand-maintained (ADR-0025) but syncwingetlink.vcxproj's
         VerifyManifestVersionMatchesProductVersion target fails the build if it
         drifts from this same property. -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <!-- Guarded by count first, not indexed directly: $(ProductVersion.Split('.')[2])
         throws an MSBuild evaluation error (MSB4184) and aborts the whole project load
         if ProductVersion doesn't have exactly three dot-separated parts - a real risk
         since ADR-0032 explicitly allows overriding it via -p:ProductVersion=... . The
         Condition on each property below is evaluated before its value expression, so
         the Split(...)[N] indexing is never reached unless _ProductVersionPartCount is
         already known to be 3; a "0" fallback plus the VerifyProductVersionFormat
         target's <Error> further down give a clear message instead of a raw MSB4184. -->
    <_ProductVersionPartCount>$(ProductVersion.Split('.').Length)</_ProductVersionPartCount>
    <ProductVersionMajor Condition="'$(_ProductVersionPartCount)' == '3'">$(ProductVersion.Split('.')[0])</ProductVersionMajor>
    <ProductVersionMinor Condition="'$(_ProductVersionPartCount)' == '3'">$(ProductVersion.Split('.')[1])</ProductVersionMinor>
    <ProductVersionPatch Condition="'$(_ProductVersionPartCount)' == '3'">$(ProductVersion.Split('.')[2])</ProductVersionPatch>
    <ProductVersionMajor Condition="'$(_ProductVersionPartCount)' != '3'">0</ProductVersionMajor>
    <ProductVersionMinor Condition="'$(_ProductVersionPartCount)' != '3'">0</ProductVersionMinor>
    <ProductVersionPatch Condition="'$(_ProductVersionPartCount)' != '3'">0</ProductVersionPatch>
    <OutDir>$(MSBuildThisFileDirectory)build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)build\obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <GenerateProjectSpecificOutputFolder>false</GenerateProjectSpecificOutputFolder>
  </PropertyGroup>
  <!-- Fails every project's build with a clear message, rather than letting a malformed
       -p:ProductVersion=... reach either the (safe, "0"-defaulted) properties above or
       syncwingetlink.vcxproj's own VerifyManifestVersionMatchesProductVersion target
       silently comparing against a wrong fallback. -->
  <Target Name="VerifyProductVersionFormat" BeforeTargets="Build">
    <Error
      Condition="'$(_ProductVersionPartCount)' != '3'"
      Text="ProductVersion ('$(ProductVersion)') must have exactly three dot-separated numeric parts (e.g. '0.1.0') - found $(_ProductVersionPartCount)." />
  </Target>
</Project>
