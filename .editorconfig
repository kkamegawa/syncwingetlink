# SPDX-License-Identifier: MIT
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C++ sources and headers
[*.{c,cpp,cc,cxx,h,hpp,hxx,inl}]
indent_size = 4
max_line_length = 100

# MSBuild project files. Visual Studio writes these with two-space indentation;
# matching it keeps diffs clean when the IDE rewrites a project.
[*.{sln,vcxproj,vcxproj.filters,props,targets,manifest}]
indent_size = 2
trim_trailing_whitespace = false

# The solution file is tab-indented and must keep CRLF.
[*.sln]
indent_style = tab

[*.{json,yml,yaml}]
indent_size = 2

# Markdown uses two trailing spaces for hard line breaks.
[*.md]
trim_trailing_whitespace = false
max_line_length = 90

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.sh]
end_of_line = lf
indent_size = 2
