<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{0306357D-16F1-402D-AC99-1B5DA4D2CF22}</ProjectGuid>
    <RootNamespace>syncwingetlink</RootNamespace>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(MSBuildThisFileDirectory)..\props\syncwingetlink.common.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="main.cpp" />
  </ItemGroup>
  <ItemGroup>
    <!-- VS_VERSION_INFO resource (issue #118, docs/adr-phase-6.md ADR-0032). Executable
         project only, matching how app.manifest above is already scoped - not
         syncwingetlink.core, which produces a static library, not a shipped binary. -->
    <ResourceCompile Include="syncwingetlink.rc" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="syncwingetlink.core.vcxproj">
      <Project>{F662528B-4B65-4276-8F84-1DB853F869A3}</Project>
    </ProjectReference>
  </ItemGroup>
  <ItemDefinitionGroup>
    <Link>
      <!-- Entry-point DLL search hardening (docs/adr-phase-5.md ADR-0024): restricts
           the load flags embedded for this executable's dependent-DLL loads. Scoped to
           the executable project only, not core/tests, since it is a property of the
           shipped binary. -->
      <AdditionalOptions>/DEPENDENTLOADFLAG:0x800 %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <ResourceCompile>
      <!-- The same single source src/cli/Version.h's kVersion derives from (issue
           #118, docs/adr-phase-6.md ADR-0032) - see Directory.Build.props's
           ProductVersion property. -->
      <PreprocessorDefinitions>SYNCWINGETLINK_VER_MAJOR=$(ProductVersionMajor);SYNCWINGETLINK_VER_MINOR=$(ProductVersionMinor);SYNCWINGETLINK_VER_PATCH=$(ProductVersionPatch);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
  <!-- Issue #118 / docs/adr-phase-6.md ADR-0032: src/app.manifest's assemblyIdentity
       version stays hand-maintained (docs/adr-phase-5.md ADR-0025) rather than
       generated, but this target turns that manual checklist step into a mechanical
       one - it fails the build, not just a test run, so a drift is caught before
       anything else even attempts to link. -->
  <Target Name="VerifyManifestVersionMatchesProductVersion" BeforeTargets="Build">
    <PropertyGroup>
      <_ManifestContent>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)app.manifest'))</_ManifestContent>
      <!-- Anchored to start searching only after "assemblyIdentity" so this never
           matches the unrelated manifestVersion="1.0" attribute on the root
           <assembly> element earlier in the file. -->
      <_ManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($(_ManifestContent), 'assemblyIdentity[\s\S]*?version=&quot;([\d\.]+)&quot;').Groups[1].Value)</_ManifestVersion>
      <_ExpectedManifestVersion>$(ProductVersion).0</_ExpectedManifestVersion>
    </PropertyGroup>
    <Error
      Condition="'$(_ManifestVersion)' != '$(_ExpectedManifestVersion)'"
      Text="app.manifest's assemblyIdentity version ('$(_ManifestVersion)') does not match ProductVersion ('$(ProductVersion)', expected manifest value '$(_ExpectedManifestVersion)'). Update app.manifest's version attribute to match (docs/adr-phase-6.md ADR-0032)." />
  </Target>
</Project>
