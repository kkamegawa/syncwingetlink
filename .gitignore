# ---- vcpkg ----
# Native dependencies use vcpkg, not NuGet (see docs/adr.md ADR-0007).
# Manifest-mode install tree: regenerated by restore, never committed.
# vcpkg.json and vcpkg-configuration.json ARE tracked.
vcpkg_installed/
# Artifacts of a locally vendored vcpkg clone, should one ever be added.
vcpkg/buildtrees/
vcpkg/downloads/
vcpkg/installed/
vcpkg/packages/

